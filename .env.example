# Copy to .env (git-ignored) and fill in. Used by:
#  - data_generator/load_to_snowflake.py (via python-dotenv)
#  - terraform (export these into your shell before `terraform apply`)
#  - orchestration/airflow/docker-compose.yml (docker compose reads .env in this folder automatically;
#    for the airflow stack, copy this file to orchestration/airflow/.env instead)

# --- Snowflake connection -----------------------------------------------
SNOWFLAKE_ACCOUNT=your_account_identifier      # e.g. xy12345.ap-southeast-1, or orgname-accountname — used by the Python connector
# terraform's snowflake provider wants the org/account split instead of the combined form above.
# For a Snowsight URL like https://app.snowflake.com/<org>/<account>/, these are that <org> and <account>.
SNOWFLAKE_ORGANIZATION_NAME=your_org_name
SNOWFLAKE_ACCOUNT_NAME=your_account_name
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password               # omit if using key-pair auth
SNOWFLAKE_PRIVATE_KEY_PATH=                    # path to an unencrypted PEM key, alternative to password

SNOWFLAKE_DATABASE=TRADE_ANALYTICS
SNOWFLAKE_WAREHOUSE=TRADE_ANALYTICS_WH
SNOWFLAKE_ROLE=TRADE_ANALYTICS_LOADER          # role used by the ingestion script
SNOWFLAKE_TRANSFORMER_ROLE=TRADE_ANALYTICS_TRANSFORMER  # role used by dbt
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_TRANSFORM_SCHEMA=ANALYTICS

# --- Airflow SMTP alerting (pipeline-failure emails) ---------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=
ALERT_EMAIL_TO=

# --- Airflow admin login (local docker-compose only) ----------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
