@startuml architecture
skinparam componentStyle rectangle
skinparam backgroundColor white

package "Snowflake" {
  component "GENERATE_TRADE_FILES\n(Snowpark procedure)" as PROC
  component "GENERATE_TRADE_FILES_TASK\n(schedule: N min, default 2)" as GENTASK
  component "INGEST_TRADES_TASK\n(schedule: N min, default 5)" as INGESTTASK

  database "BRONZE schema" {
    [TRADES_STAGE\n(internal stage)] as STAGE
    [TRADES_RAW\n(landing table)] as RAWTBL
    [TRADES_RAW_STREAM\n(CDC stream)] as STREAM
  }

  database "SILVER schema (dbt)" {
    [stg_trades] as STG
    [int_trades_evaluated\n(business rules)] as EVAL
  }

  database "GOLD schema (dbt marts)" {
    [valid_trades] as VALID
    [rejected_trades\n(audit log)] as REJ
    [trade_status\n(view: ACTIVE/EXPIRED,\nnotional_usd via macro)] as STATUS
    [valid_trades_snapshot\n(Type 2 SCD, monthly)] as SNAP
  }

  [TASK_FAILURE_ALERT\n(snowflake_alert, every 15 min)] as ALERT
  [ACCOUNT_USAGE / INFORMATION_SCHEMA\n(QUERY_HISTORY, COPY_HISTORY,\nTASK_HISTORY, WAREHOUSE_METERING)] as ADMIN
}

package "dbt Cloud" {
  [Hourly job:\ndbt run + dbt test] as DBT
  [Monthly job (1st, 01:00 UTC):\ndbt snapshot] as DBTSNAP
}

package "Optional / alternative" {
  [Streamlit dashboard] as DASH
  [Airflow (Docker Compose)\nalternative orchestrator] as AF
}

GENTASK --> PROC : CALL (own schedule)
PROC --> STAGE : writes .jsonl
INGESTTASK --> STAGE : polls (own schedule)
INGESTTASK --> RAWTBL : COPY INTO
RAWTBL ..> STREAM : change capture
STREAM --> STG : consumed by\nincremental model
STG --> EVAL : version/maturity rules
EVAL --> VALID : ACCEPTED
EVAL --> REJ : REJECTED (+ reason)
VALID --> STATUS : computed status
VALID --> SNAP : dbt snapshot\n(check strategy)
DBT --> STG
DBT --> EVAL
DBT --> VALID
DBT --> REJ
DBT --> STATUS
DBTSNAP --> SNAP

STATUS --> DASH
REJ --> DASH

GENTASK ..> ALERT : TASK_HISTORY
INGESTTASK ..> ALERT : TASK_HISTORY
ALERT ..> ADMIN

AF ..> PROC : could call instead\n(not the primary path)

note right of ALERT
  Condition: either task FAILED
  in INFORMATION_SCHEMA.TASK_HISTORY
  in the last 15 min.
  Action: SYSTEM$SEND_EMAIL via
  TRADE_PIPELINE_ALERT integration.
  Fires independent of dbt Cloud.
end note

note right of GENTASK
  task_auto_retry_attempts = 2
  suspend_task_after_num_failures = 3
end note

@enduml
